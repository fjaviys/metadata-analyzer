# ===== Metadata Analyzer — environment example =====
# Copy to .env and adjust. NEVER commit the real .env.

# ---- NAS / OMV / Portainer (docker-compose.nas.yml, imágenes desde GHCR) ----
# IP o hostname del NAS accesible desde tu navegador:
NAS_HOST=192.168.1.50
# Puertos publicados (cámbialos si están ocupados):
BACKEND_PORT=8000
FRONTEND_PORT=4321
# Medios en solo lectura por defecto (pon false SOLO para correcciones reales):
MEDIA_READ_ONLY=true

# ---- Backend ----
APP_ENV=production
LOG_LEVEL=INFO
# Comma-separated absolute paths that are allowed as analysis/correction roots.
# Everything outside these roots is rejected by core/security.py.
ALLOWED_MEDIA_ROOTS=/media
# SQLite database path (inside the backend container)
DATABASE_URL=sqlite:///data/db/metadata_analyzer.db
# Backups
BACKUP_DIR=data/backups
BACKUP_KEEP_LAST=10
# Abort correction run and restore from backup if error ratio exceeds this (0..1)
CORRECTION_ERROR_ABORT_RATIO=0.10
# Date validation range
DATE_MIN_YEAR=1990
DATE_MAX_YEAR_OFFSET=5

# ---- Media mount ----
# Host path to your media (mounted read-only by default in docker-compose)
MEDIA_HOST_PATH=/srv/media
# Set to rw ONLY when you are ready to run real corrections (see docs/DEPLOYMENT.md)
MEDIA_MOUNT_MODE=ro

# ---- Immich (optional) ----
IMMICH_BASE_URL=http://immich-server:2283
IMMICH_API_KEY=

# ---- OpenMediaVault (optional) ----
OMV_BASE_URL=
OMV_USERNAME=
OMV_PASSWORD=

# ---- Frontend ----
PUBLIC_API_BASE_URL=/api
PUBLIC_WS_BASE_URL=/ws

# ---- Nginx ----
NGINX_CLIENT_MAX_BODY_SIZE=2048m

# ---- PostgreSQL (optional migration target; disabled by default) ----
# POSTGRES_USER=metadata
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=metadata_analyzer
