---
import MainLayout from '../layouts/MainLayout.astro';
import ReorganizeRunner from '../components/ReorganizeRunner.vue';
import StepNav from '../components/StepNav.astro';
---
<MainLayout title="Reorganizar · Metadata Analyzer" active="reorganize">
  <h1 class="mb-2 text-xl font-semibold text-slate-800">Reorganización de carpetas</h1>
  <p class="mb-6 max-w-2xl text-slate-600">
    Mueve los archivos a una nueva estructura de carpetas según su fecha, sin tocar sus
    metadatos. Empieza siempre por el modo simulación (dry-run). La reorganización real
    requiere confirmación explícita y registra cada movimiento para poder deshacerlo.
  </p>
  <ReorganizeRunner client:load />
  <StepNav
    prev={{ href: '/corrections', label: 'Correcciones' }}
    next={{ href: '/', label: 'Inicio' }}
  />
</MainLayout>
