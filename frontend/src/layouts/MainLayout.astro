---
import '../styles/global.css';

interface Props {
  title?: string;
  active?: string;
}
const { title = 'Metadata Analyzer', active = '' } = Astro.props;

// Config de runtime inyectada desde el servidor (SSR). Permite que una imagen ya
// construida apunte a cualquier backend sin recompilar. Si no se define, se usan
// rutas relativas (mismo origen, p. ej. tras un proxy inverso).
const env = (globalThis as any).process?.env ?? {};
const runtimeConfig = {
  apiBase: env.MA_API_BASE || '/api',
  wsBase: env.MA_WS_BASE || '',
};

const nav = [
  { href: '/', label: 'Inicio', key: 'home' },
  { href: '/config', label: 'Configuración', key: 'config' },
  { href: '/analysis', label: 'Análisis', key: 'analysis' },
  { href: '/corrections', label: 'Correcciones', key: 'corrections' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline set:html={`window.__MA_CONFIG__=${JSON.stringify(runtimeConfig)}`}></script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2">
          <span class="text-xl">🗂️</span>
          <span class="text-lg font-semibold text-brand-700">Metadata Analyzer</span>
        </a>
        <nav class="flex gap-1">
          {nav.map((item) => (
            <a
              href={item.href}
              class={`rounded-lg px-3 py-1.5 text-sm font-medium transition-colors ${
                active === item.key
                  ? 'bg-brand-50 text-brand-700'
                  : 'text-slate-600 hover:bg-slate-100'
              }`}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-4 py-8 text-center text-xs text-slate-400">
      Metadata Analyzer · Las correcciones requieren confirmación explícita y se
      realizan con backup y verificación.
    </footer>
  </body>
</html>
